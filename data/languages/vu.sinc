    dm:1 = vudest;
    rx:4 = rv;
    ry:4 = rv;
    rz:4 = rv;
    rw:4 = rv;
    if ((dm & 8) == 0) goto <sx>; WFTx = rx; <sx>
    if ((dm & 4) == 0) goto <sy>; WFTy = ry; <sy>
    if ((dm & 2) == 0) goto <sz>; WFTz = rz; <sz>
    if ((dm & 1) == 0) goto <sw>; WFTw = rw; <sw>
}
:vrinit "R", vufs^fsf is vuinst & fsf & FSF & vufs & vuop_0_10=0x43e {
    vi20 = (FSF & 0x7fffff) | 0x3f800000;
}
:vrxor "R", vufs^fsf is vuinst & fsf & FSF & vufs & vuop_0_10=0x43f {
    vi20 = ((vi20 ^ FSF) & 0x7fffff) | 0x3f800000;
}
:c2 imm25 is prime=18 & vuco=1 & imm25 {
    cop2Operation(imm25:4);
}

with : prime=18 {
:bc2f Rel16 is vuop_21_25=8 & vuop_16_20=0 & Rel16 {
    c:1 = vu0Condition();
    delayslot(1);
    if (c != 0) goto inst_next;
    goto Rel16;
}
:bc2t Rel16 is vuop_21_25=8 & vuop_16_20=1 & Rel16 {
    c:1 = vu0Condition();
    delayslot(1);
    if (c == 0) goto inst_next;
    goto Rel16;
}
:bc2fl Rel16 is vuop_21_25=8 & vuop_16_20=2 & Rel16 {
    c:1 = vu0Condition();
    if (c != 0) goto inst_next;
    delayslot(1);
    goto Rel16;
}
:bc2tl Rel16 is vuop_21_25=8 & vuop_16_20=3 & Rel16 {
    c:1 = vu0Condition();
    if (c == 0) goto inst_next;
    delayslot(1);
    goto Rel16;
}
:qmfc2^I RT, vufs is vuop_21_25=1 & vuop_1_10=0 & I & RT & vufs & VFSx & VFSy & VFSz & VFSw & rt_w0 & rt_w1 & rt_w2 & rt_w3 {
    rt_w0 = VFSx;
    rt_w1 = VFSy;
    rt_w2 = VFSz;
    rt_w3 = VFSw;
}
:qmtc2^I RTsrc, vufs is vuop_21_25=5 & vuop_1_10=0 & I & RTsrc & vufs & WFSx & WFSy & WFSz & WFSw & RTw0 & RTw1 & RTw2 & RTw3 {
    tp0:4 = RTw0;
    tp1:4 = RTw1;
    tp2:4 = RTw2;
    tp3:4 = RTw3;
    WFSx = tp0;
    WFSy = tp1;
    WFSz = tp2;
    WFSw = tp3;
}
:cfc2^I RT, RCC is vuop_21_25=2 & vuop_1_10=0 & I & RT & RCC {
    RT = sext(RCC);
}
:ctc2^I RTsrc, WCC is vuop_21_25=6 & vuop_1_10=0 & I & RTsrc & WCC {
    WCC = RTsrc:4;
}
}

:lqc2 vuft, OFF_BASE is prime=54 & OFF_BASE & vuft & WFTx & WFTy & WFTz & WFTw {
    ea:4 = OFF_BASE & 0xfffffff0;
    WFTx = *[ram]:4 (ea + 0);
    WFTy = *[ram]:4 (ea + 4);
    WFTz = *[ram]:4 (ea + 8);
    WFTw = *[ram]:4 (ea + 12);
}
:sqc2 vuft, OFF_BASE is prime=62 & OFF_BASE & vuft & VFTx & VFTy & VFTz & VFTw {
    ea:4 = OFF_BASE & 0xfffffff0;
    *[ram]:4 (ea + 0) = VFTx;
    *[ram]:4 (ea + 4) = VFTy;
    *[ram]:4 (ea + 8) = VFTz;
    *[ram]:4 (ea + 12) = VFTw;
}
